SPRING_PROFILES_ACTIVE=development
# LOCAL uses DATABASE_LOCAL_*; REMOTE uses DATABASE_URL/USERNAME/PASSWORD.
DATABASE_TARGET=LOCAL
DATABASE_LOCAL_URL=jdbc:mysql://127.0.0.1:3306/portfolio_manager_local?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_LOCAL_USERNAME=root
DATABASE_LOCAL_PASSWORD=root
DATABASE_URL=jdbc:mysql://mysql:3306/portfolio_manager?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=portfolio
DATABASE_PASSWORD=portfolio
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MARKET_DATA_PROVIDER=twelve-data
MARKET_SYNC_CRON=0 0 22 * * MON-FRI
MARKET_TIMEZONE=America/New_York
MARKET_BATCH_SIZE=1
MARKET_REQUEST_TIMEOUT_SECONDS=10
MARKET_MAX_RETRIES=2
MARKET_RETRY_BACKOFF_MILLIS=250
MARKET_REQUEST_INTERVAL_MILLIS=8000
MARKET_MANUAL_POLL_INTERVAL_MS=2000
TWELVE_DATA_API_KEY=
VITE_API_BASE_URL=http://localhost:8000
