SPRING_PROFILES_ACTIVE=development
# LOCAL uses DATABASE_LOCAL_*; REMOTE uses DATABASE_URL/USERNAME/PASSWORD.
DATABASE_TARGET=LOCAL
FLYWAY_ENABLED=true
DATABASE_LOCAL_URL=jdbc:mysql://127.0.0.1:3306/portfolio_manager_local?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DATABASE_LOCAL_USERNAME=root
DATABASE_LOCAL_PASSWORD=root
DATABASE_URL=jdbc:mysql://mysql:3306/portfolio_manager?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DATABASE_USERNAME=portfolio
DATABASE_PASSWORD=portfolio
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MARKET_DATA_PROVIDER=alpaca
MARKET_SYNC_CRON=0 0 22 * * MON-FRI
MARKET_TIMEZONE=Asia/Shanghai
MARKET_CLOSE_TIME=16:15
MARKET_CLOSE_TIMEZONE=America/New_York
MARKET_BATCH_SIZE=50
MARKET_REQUEST_CONCURRENCY=4
MARKET_REQUEST_TIMEOUT_SECONDS=10
MARKET_MAX_RETRIES=2
MARKET_RETRY_BACKOFF_MILLIS=250
MARKET_MANUAL_POLL_INTERVAL_MS=2000
MARKET_INTRADAY_INTERVAL=1min
MARKET_INTRADAY_LOOKBACK_DAYS=5
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_BASE_URL=https://data.alpaca.markets/v2
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_REQUESTS_PER_MINUTE=180
TWELVE_DATA_API_KEY=
